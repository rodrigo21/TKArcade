# Maintainer: Rodrigo Bezerra <rodrigobezerra21@gmail.com>

pkgname=tksteamlaunch
pkgver=0.9.0
pkgrel=1
pkgdesc='Minimal Steam launch wrapper'
arch=('any')
url='https://github.com/rodrigo21/TKSteamLaunch'
license=('GPL-3.0-or-later')
depends=('hicolor-icon-theme' 'python' 'pyside6' 'python-vdf' 'python-jeepney')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-uv-dynamic-versioning')
checkdepends=('python-pytest')
optdepends=('gamemode: Feral GameMode support'
            'gamescope: Gamescope session support'
            'mangohud: MangoHud overlay support'
            'ludusavi: save backup and restore support (AUR)'
            'protontricks: winetricks verbs support'
            'linux-rt-upscaler: real-time upscaling support (local package)'
            'libnotify: desktop notifications')
source=("$pkgname-$pkgver.tar.gz::https://github.com/rodrigo21/TKSteamLaunch/archive/v$pkgver.tar.gz")
sha256sums=('5ef96a5127be954c982a30f01152d6774e4d086770e3eb2d25ff195337266249')

build() {
    cd "TKSteamLaunch-$pkgver"

    UV_DYNAMIC_VERSIONING_BYPASS=$pkgver python -m build --wheel --no-isolation
}

check() {
    cd "TKSteamLaunch-$pkgver"

    QT_QPA_PLATFORM=offscreen python -m pytest tests/ -q
}

package() {
    cd "TKSteamLaunch-$pkgver"

    python -m installer --destdir="$pkgdir" dist/*.whl

    install -Dm644 packaging/tksteamlaunch.desktop "$pkgdir/usr/share/applications/tksteamlaunch.desktop"
    install -Dm644 src/tksteamlaunch/icons/tksteamlaunch.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/tksteamlaunch.svg"
    install -Dm644 packaging/man/tksteamlaunch.1 "$pkgdir/usr/share/man/man1/tksteamlaunch.1"
}
