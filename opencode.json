{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "instructions": ["docs/STATE.md", "docs/README.md", "docs/GIT.md"],
  "tool_output": {
    "max_lines": 120,
    "max_bytes": 8000
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    }
  },
  "agents": {
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "permissions": [
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" }
      ]
    },
    "plan": {
      "permissions": [
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" }
      ]
    }
  },
  "plugins": []
}
