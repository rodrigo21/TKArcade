{
  "$schema": "https://opencode.ai/config.json",
  "model": "console-openrouter/~deepseek/deepseek-flash-latest",
  "instructions": ["docs/STATE.md", "docs/README.md", "docs/GIT.md"],
  "tool_output": {
    "max_lines": 120,
    "max_bytes": 8000
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    }
  },
  "agents": {
    "build": {
      "model": "console-openrouter/~deepseek/deepseek-flash-latest",
      "permissions": [
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" }
      ]
    },
    "plan": {
      "permissions": [
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "plugins": []
}
